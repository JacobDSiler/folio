// ───────────────────────────────────────────────────────────────────
// Folio — Cloud Storage security rules
// ───────────────────────────────────────────────────────────────────
// Verified against the app's actual Storage call sites (window._storage
// usage in app.html). Storage rules CAN read Firestore (firestore.get),
// so audio access is scoped to the owning folio's uid / published state.
// See docs/LAUNCH-READINESS.md → "Applying these rules".
// ───────────────────────────────────────────────────────────────────

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function folioDoc(folioId) {
      return firestore.get(
        /databases/(default)/documents/folio_projects/$(folioId)
      );
    }
    function isOwner(folioId) {
      let d = folioDoc(folioId);
      return request.auth != null
        && d != null
        && request.auth.uid == d.data.uid;
    }
    function isPublished(folioId) {
      let d = folioDoc(folioId);
      return d != null
        && d.data.release != null
        && d.data.release.published == true;
    }

    // Audiobook tracks — written by the app at
    //   folio_audio/<folioId>/<trackKey>
    match /folio_audio/{folioId}/{trackKey} {
      // Readable by the owner, or by anyone if the folio is published.
      // The published branch deliberately does NOT require auth, so
      // reader-mode streaming survives a pre-anonymous-auth race.
      allow read: if isPublished(folioId) || isOwner(folioId);
      // Only the owner uploads, replaces, or deletes tracks.
      allow write, delete: if isOwner(folioId);
    }

    // Cover / chapter / inline images — written by the app at
    //   folio_images/<folioId>/<imageId>
    // Same visibility model as audio: readable by the owner or by
    // anyone once the folio is published (so reader-mode and inline
    // illustrations load without owner auth), writable only by the
    // owner. The published branch intentionally omits the auth check.
    match /folio_images/{folioId}/{imageId} {
      allow read: if isPublished(folioId) || isOwner(folioId);
      allow write, delete: if isOwner(folioId);
    }

    // Product photo templates — Adobe Stock PSDT files hosted here
    // instead of the git repo to keep the repo lean. Public read (any
    // Folio user can render templates onto their covers). Writes are
    // Jacob-only via the Firebase Console or gsutil — no client uploads.
    match /photo_templates/{fileName} {
      allow read:  if true;
      allow write: if false;  // console/gsutil only
    }

    // Digital bonuses (Phase 0) — extras readers unlock alongside
    //   folio_bonuses/<folioId>/<bonusId>/<fileName>
    // Owner uploads/deletes; anyone can read once the folio is
    // published (paywall lives at the reader-render layer — the URL is
    // gated by unlock state, and once the URL is known it's public,
    // same trust model as inline images + audio). For truly sensitive
    // bonuses (early drafts, private art), owners should use the
    // external-link kind pointing at a signed-URL host they control.
    match /folio_bonuses/{folioId}/{bonusId}/{fileName} {
      allow read: if isPublished(folioId) || isOwner(folioId);
      allow write, delete: if isOwner(folioId);
    }

    // Lulu print-job PDFs — written at
    //   folio-lulu/<stamp>-interior.pdf  and  ...-cover.pdf
    // These are transient uploads with a flat, non-prefixed name, so
    // there's no per-user path segment to scope on — this can only be
    // gated to "any signed-in user". Audit polish item: re-path to
    // folio-lulu/<uid>/... so it can be owner-scoped.
    match /folio-lulu/{file} {
      allow read, write: if request.auth != null;
    }

    // Anything not matched above is denied by default.
  }
}
