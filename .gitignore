# Stray / personal files that are not part of the Folio app.
# The app repo ships index.html, app.html, the workers, docs, and
# scripts — nothing else. These patterns keep one-off exports and
# an author's personal data out of git so folio-push stays clean.
Folio - Welcome (standalone).html
*-pronunciations.csv
*-characters.csv
.git/index.lock
.aider*
.claude/
.wrangler/

# Product photo PSDT templates — hosted in Firebase Storage, not git
press/photos/templates/*.psdt

# Personal outreach drafts + author notes. Working documents for
# Jacob's own use (message drafts, comp strategies, tester feedback)
# — not part of the Folio app or its public documentation.
docs/THOMAS_*.md
docs/AUTHORS.md
docs/OUTREACH_*.md
# ── Bubblewrap TWA (Android wrapper) build artifacts ──────────────
# Generated by `bubblewrap build` from the PWA manifest. All of it
# is derived output; source-of-truth is the web app itself + the
# twa-manifest.json (also ignored — it's regenerated per build).
# Rebuild locally with `bubblewrap build`; don't try to commit the
# outputs. Added 2026-08-20 alongside the folio-push silent-revert
# recovery.
android.keystore
app/
build/
build.gradle
.gradle/
gradle/
gradle.properties
gradlew
gradlew.bat
settings.gradle
twa-manifest.json
manifest-checksum.txt
app-release-bundle.aab
app-release-signed.apk
app-release-signed.apk.idsig
app-release-unsigned-aligned.apk
app-release-unsigned.apk
